{
  "schemaVersion": "soda.scylladb.com/runtime-contract/v1alpha1",
  "scyllaDoctorVersion": "1.15",
  "runtime": "The scylla container of an Operator-managed ScyllaDB Pod. SODA runs Scylla Doctor inside it over exec.",
  "interpreter": "/opt/scylladb/python3/bin/python3",
  "notes": [
    "Derived from an strace of a complete Scylla Doctor 1.15 run in scylladb/scylla:2026.3.3 and from the Scylla Doctor source (OPERATOR-551 spike).",
    "required: SODA cannot run Scylla Doctor, or most checks fail. recommended: the named checks fail or skip without it. optional: missing today; installing it enables the named checks.",
    "Owned by Scylla Doctor: each release is tested against every ScyllaDB image the pinning operator release supports."
  ],
  "requirements": [
    {"id": "python", "level": "required", "check": {"type": "executable", "path": "/opt/scylladb/python3/bin/python3"},
     "usedBy": "Scylla Doctor itself, cqlsh, perftune.py", "impact": "Scylla Doctor cannot start"},
    {"id": "python-version", "level": "required", "check": {"type": "pythonVersion", "min": "3.8"},
     "usedBy": "Scylla Doctor itself", "impact": "Scylla Doctor cannot start"},
    {"id": "pyyaml", "level": "required", "check": {"type": "pythonModule", "module": "yaml"},
     "usedBy": "Scylla Doctor itself (its only non-stdlib import)", "impact": "Scylla Doctor cannot start"},
    {"id": "posix-shell", "level": "required", "check": {"type": "command", "names": ["sh", "cat", "mkdir", "rm", "chmod", "timeout"]},
     "usedBy": "SODA: staging, bounding the run, cleanup", "impact": "SODA cannot run Scylla Doctor"},
    {"id": "tmp-writable", "level": "required", "check": {"type": "writableDirectory", "path": "/tmp"},
     "usedBy": "SODA: run directory", "impact": "SODA cannot run Scylla Doctor"},
    {"id": "home-writable", "level": "required", "check": {"type": "writableDirectory", "path": "/root"},
     "usedBy": "cqlsh unpacks its bundled packages into $HOME/.shiv", "impact": "cqlsh fails, and with it 26 checks"},
    {"id": "scylla-yaml", "level": "required", "check": {"type": "file", "path": "/etc/scylla/scylla.yaml"},
     "usedBy": "Scylla Doctor's configuration checks, cqlsh address", "impact": "29 checks fail"},
    {"id": "cqlsh", "level": "required", "check": {"type": "executable", "path": "/opt/scylladb/share/cassandra/bin/cqlsh"},
     "usedBy": "every CQL check, and the REST checks (API address from system.config)", "impact": "26 checks fail"},
    {"id": "scylla", "level": "recommended", "check": {"type": "executable", "path": "/opt/scylladb/bin/scylla"},
     "usedBy": "ScyllaVersion, ScyllaBinary, nodetool", "impact": "3 checks fail"},
    {"id": "nodetool", "level": "recommended", "check": {"type": "executable", "path": "/opt/scylladb/bin/nodetool"},
     "usedBy": "NodetoolCFStats", "impact": "1 check fails"},
    {"id": "perftune", "level": "recommended", "check": {"type": "executable", "path": "/opt/scylladb/scripts/perftune.py"},
     "usedBy": "StorageConfiguration, PerftuneSystemConfiguration, CPUSet", "impact": "3 checks fail"},
    {"id": "hwloc-calc", "level": "recommended", "check": {"type": "executable", "path": "/opt/scylladb/bin/hwloc-calc"},
     "usedBy": "CPUSet, perftune.py", "impact": "1 check fails"},
    {"id": "seastar-cpu-map", "level": "recommended", "check": {"type": "executable", "path": "/opt/scylladb/scripts/seastar-cpu-map.sh"},
     "usedBy": "SeastarCPUMap", "impact": "1 check fails"},
    {"id": "scylla-d", "level": "recommended", "check": {"type": "directory", "path": "/etc/scylla.d"},
     "usedBy": "ScyllaExtraConfigurationFiles, CPUSet", "impact": "2 checks fail"},
    {"id": "sysconfig", "level": "recommended", "check": {"type": "file", "path": "/etc/sysconfig/scylla-server"},
     "usedBy": "ScyllaSystemConfigurationFiles", "impact": "1 check fails"},
    {"id": "os-release", "level": "recommended", "check": {"type": "file", "path": "/etc/os-release"},
     "usedBy": "OS", "impact": "1 check fails"},
    {"id": "data-dir", "level": "recommended", "check": {"type": "directory", "path": "/var/lib/scylla"},
     "usedBy": "ScyllaSSTables", "impact": "1 check reports no SSTables"},
    {"id": "supervisorctl", "level": "recommended", "check": {"type": "command", "names": ["supervisorctl"]},
     "usedBy": "ServiceManager, ScyllaServices; REST checks fall back to the process list", "impact": "service manager misdetected as systemd, 1 check fails"},
    {"id": "rpm", "level": "recommended", "check": {"type": "command", "names": ["rpm"]},
     "usedBy": "ScyllaVersion (edition detection)", "impact": "1 check fails"},
    {"id": "base-tools", "level": "recommended",
     "check": {"type": "command", "names": ["bash", "basename", "dirname", "readlink", "realpath", "cut", "grep", "ls", "env", "df", "mount", "free", "lscpu", "dmesg", "uname", "sysctl", "pgrep", "taskset", "systemd-detect-virt"]},
     "usedBy": "wrappers of ScyllaDB's tools and the OS checks", "impact": "the checks using the missing tool skip or fail"},
    {"id": "network-tools", "level": "optional", "check": {"type": "command", "names": ["ethtool", "ip", "iptables", "ss", "lspci", "chronyc"]},
     "usedBy": "NICs, IPAddresses, IPRoutes, InfrastructureProvider, FirewallRules, TCPConnections, LSPCI, ChronyStatus", "impact": "missing today: 9 checks skip"}
  ],
  "services": [
    {"id": "cql", "endpoint": "rpc_address:9042 (scylla.yaml)", "usedBy": "cqlsh"},
    {"id": "rest-api", "endpoint": "api_address:10000 (system.config; the operator sets 127.0.0.1)", "usedBy": "REST checks, nodetool"},
    {"id": "supervisord", "endpoint": "127.0.0.1:9001 (/etc/supervisord.conf)", "usedBy": "supervisorctl"},
    {"id": "scylla-process", "endpoint": "a process named scylla in the container's PID namespace", "usedBy": "SeastarCPUMap, service fallback"}
  ]
}
